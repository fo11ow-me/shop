# 服务器部署环境变量配置
# 复制此文件为 .env 并填写真实值，放置在服务器的 /opt/app/mall/.env
#
# 安全警告:
#   - .env 文件包含敏感信息，严禁提交到 Git
#   - 设置权限: chmod 600 .env
#   - 生成随机密码: openssl rand -base64 32
#   - 生成 JWT 密钥: openssl rand -base64 32

# MySQL 数据库
MYSQL_ROOT_PASSWORD=CHANGEME
DB_PASSWORD=CHANGEME

# Redis
REDIS_PASSWORD=CHANGEME

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=CHANGEME

# Aliyun OSS (从阿里云 RAM 控制台获取)
OSS_ACCESS_KEY_ID=CHANGEME
OSS_ACCESS_KEY_SECRET=CHANGEME

# JWT 签名密钥 (每个生成独立的 256 位随机密钥)
JWT_ADMIN_SECRET=CHANGEME
JWT_PORTAL_SECRET=CHANGEME
